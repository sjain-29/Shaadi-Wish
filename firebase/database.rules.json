{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "mustChange": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "couples": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active'",
        "$field": {
          ".write": "(auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active') && $field.matches(/^(partner1|partner2|weddingDate|location|welcomeMessage|photo1|photo2|theme|showContributors|updatedAt|paymentsReady)$/)"
        }
      }
    },
    "slugs": {
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$slug": {
        ".read": true
      }
    },
    "publicProfiles": {
      "$coupleId": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "$field": {
          ".write": "(auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active') && $field !== 'active' && $field !== 'slug'"
        }
      }
    },
    "publicSettings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "publicWishlists": {
      "$coupleId": {
        ".read": "root.child('publicProfiles').child($coupleId).child('active').val() === true",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')"
      }
    },
    "publicFeed": {
      "$coupleId": {
        ".read": "root.child('publicProfiles').child($coupleId).child('active').val() === true",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')"
      }
    },
    "publicGroupGifts": {
      "$coupleId": {
        ".read": "root.child('publicProfiles').child($coupleId).child('active').val() === true",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$groupId": {
          ".write": "!data.exists() && root.child('publicProfiles').child($coupleId).child('active').val() === true && !newData.child('verified').exists() && !newData.child('pending').exists() && !newData.child('members').exists() && !newData.child('completedAt').exists() && newData.child('target').isNumber() && newData.child('organizer').isString() && newData.child('organizer').val().length <= 60"
        }
      }
    },
    "groupGifts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$groupId": {
          ".write": "!data.exists() && root.child('publicProfiles').child($coupleId).child('active').val() === true && newData.child('verified').val() === 0 && !newData.child('members').exists() && !newData.child('completedAt').exists() && newData.child('target').isNumber() && newData.child('organizer').isString() && newData.child('organizer').val().length <= 60"
        }
      }
    },
    "wishlists": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')"
      }
    },
    "coupleStats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')"
      }
    },
    "thankYouCards": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')"
      }
    },
    "paymentSettings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')"
      }
    },
    "contributions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$id": {
          ".write": "!data.exists() && root.child('publicProfiles').child($coupleId).child('active').val() === true && newData.child('kind').val() === 'item' && newData.child('status').val() === 'PENDING_VERIFICATION' && newData.child('amount').isNumber() && newData.child('amount').val() >= 1 && newData.child('amount').val() <= 10000000 && newData.child('guestName').isString() && newData.child('guestName').val().length <= 60 && newData.child('utr').isString() && newData.child('utr').val().matches(/^[0-9]{12}$/) && !newData.child('verifiedAmount').exists() && !newData.child('verifiedAt').exists() && !newData.child('wallApproved').exists() && (!newData.child('message').exists() || (newData.child('message').isString() && newData.child('message').val().length <= 500))"
        }
      }
    },
    "lifafa": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$id": {
          ".write": "!data.exists() && root.child('publicProfiles').child($coupleId).child('active').val() === true && newData.child('kind').val() === 'lifafa' && newData.child('status').val() === 'PENDING_VERIFICATION' && newData.child('amount').isNumber() && newData.child('amount').val() >= 1 && newData.child('amount').val() <= 10000000 && newData.child('guestName').isString() && newData.child('guestName').val().length <= 60 && newData.child('utr').isString() && newData.child('utr').val().matches(/^[0-9]{12}$/) && !newData.child('verifiedAmount').exists() && !newData.child('verifiedAt').exists() && !newData.child('wallApproved').exists() && (!newData.child('message').exists() || (newData.child('message').isString() && newData.child('message').val().length <= 500))"
        }
      }
    },
    "guestReceipts": {
      "$token": {
        ".read": "$token.length >= 32",
        ".write": "(!data.exists() && $token.length >= 32 && newData.child('status').val() === 'PENDING_VERIFICATION' && newData.child('coupleId').isString()) || (data.exists() && auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('coupleId').val() === data.child('coupleId').val()))"
      }
    },
    "utrIndex": {
      "$utr": {
        ".read": true,
        ".write": "!data.exists() && newData.exists() && $utr.matches(/^[0-9]{12}$/)"
      }
    },
    "conversations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$convId": {
          ".write": "!data.exists() && root.child('publicProfiles').child($coupleId).child('active').val() === true && newData.child('guestName').isString() && newData.child('guestName').val().length <= 60 && newData.child('token').isString() && newData.child('lastFrom').val() === 'guest'",
          "lastAt": {
            ".write": "data.parent().child('token').exists()",
            ".validate": "newData.isNumber()"
          },
          "lastText": {
            ".write": "data.parent().child('token').exists()",
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "lastFrom": {
            ".write": "data.parent().child('token').exists()",
            ".validate": "newData.isString() && newData.val().matches(/^(guest|couple|system)$/)"
          },
          "unreadCouple": {
            ".write": "data.parent().child('token').exists()",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "messages": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$convId": {
          "$msgId": {
            ".write": "!data.exists() && newData.parent().parent().parent().parent().child('conversations').child($coupleId).child($convId).exists() && newData.child('text').isString() && newData.child('text').val().length <= 1000 && newData.child('from').val().matches(/^(guest|system)$/)"
          }
        }
      }
    },
    "guestThreads": {
      "$token": {
        ".read": "$token.length >= 32",
        ".write": "(!data.exists() && $token.length >= 32 && newData.child('meta').child('coupleId').isString()) || (data.exists() && auth != null && (root.child('admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('coupleId').val() === data.child('meta').child('coupleId').val()))",
        "messages": {
          "$msgId": {
            ".write": "!data.exists() && data.parent().parent().child('meta').exists() && newData.child('text').isString() && newData.child('text').val().length <= 1000"
          }
        },
        "meta": {
          "lastAt": {
            ".write": "data.parent().exists()",
            ".validate": "newData.isNumber()"
          },
          "unreadGuest": {
            ".write": "data.parent().exists()",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "reservations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$coupleId": {
        ".read": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        "$resId": {
          ".write": "!data.exists() && root.child('publicProfiles').child($coupleId).child('active').val() === true && newData.child('status').val() === 'DISCUSSING' && newData.child('guestName').isString() && newData.child('guestName').val().length <= 60"
        }
      }
    },
    "auditLogs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "_platform": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      },
      "$coupleId": {
        "$logId": {
          ".write": "!data.exists() && ((auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active'))"
        }
      }
    },
    "publicPaymentQr": {
      "$coupleId": {
        ".read": "root.child('publicProfiles').child($coupleId).child('active').val() === true",
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && root.child('users').child(auth.uid).child('coupleId').val() === $coupleId && root.child('couples').child($coupleId).child('status').val() === 'active')",
        ".validate": "newData.isString() && newData.val().length <= 600000 && (newData.val().beginsWith('data:image/jpeg;base64,') || newData.val().beginsWith('data:image/png;base64,') || newData.val().beginsWith('data:image/webp;base64,'))"
      }
    }
  }
}
